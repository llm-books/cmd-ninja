#!/usr/bin/expect -f
# Same placement proof as widget_zsh.exp, for the bash hook.
# Requires bash >= 4 (READLINE_LINE); macOS stock 3.2 won't do, so we
# use Homebrew bash when present.

set timeout 10
set ninja [file normalize [file join [file dirname [info script]] .. ninja]]
set env(NINJA_BIN) $ninja

set bash /bin/bash
if {[file exists /opt/homebrew/bin/bash]} { set bash /opt/homebrew/bin/bash }

spawn $bash --norc --noprofile -i
expect -re {\$ ?$}

send -- {eval "$("$NINJA_BIN" init bash)"}
send -- "\r"
expect -re {\$ ?$}

# --- read-only request must be FILLed ---
send -- "find files over 100 megabytes"
send -- "\007"
expect {
    -re {RISK: read_only|read-only} {}
    timeout { puts "\nFAIL: INFO block never appeared"; exit 1 }
}
expect {
    -re {find \. -type f -size \+100M} { puts "\nPASS: command landed on the bash prompt" }
    timeout { puts "\nFAIL: command was not placed"; exit 1 }
}
send -- "\025"

# --- destructive request must NOT be FILLed ---
send -- "delete all the files in my-folder"
send -- "\007"
expect {
    -re {copy or type it} {}
    timeout { puts "\nFAIL: destructive CMD line never appeared"; exit 1 }
}
send -- "echo SENTINEL_OK\r"
expect {
    -re {\nSENTINEL_OK} { puts "\nPASS: destructive command was withheld" }
    timeout { puts "\nFAIL: prompt buffer was not empty"; exit 1 }
}

send -- "exit\r"
expect eof
puts "\nALL BASH WIDGET CHECKS PASSED"
