#!/usr/bin/expect -f
# Proves the zsh ZLE widget places a safe command on the prompt line
# and withholds a destructive one. Run from the repo root after
# `go build -o ninja .`.

set timeout 10
set ninja [file normalize [file join [file dirname [info script]] .. ninja]]
set env(NINJA_BIN) $ninja

spawn zsh -f
expect -re {[%#$] ?$}

# Load the hook exactly the way a user would (path may contain spaces,
# so quote via the exported NINJA_BIN).
send -- {eval "$("$NINJA_BIN" init zsh)"}
send -- "\r"
expect -re {[%#$] ?$}

# --- Case 1: read-only request must be FILLed onto the prompt ---
send -- "find files over 100 megabytes"
send -- "\007"
expect {
    -re {RISK:.*read.only} {}
    timeout { puts "\nFAIL: INFO block never appeared"; exit 1 }
}
# reset-prompt redraws the buffer; the filled command must be visible
expect {
    -re {find \. -type f -size \+100M} { puts "\nPASS: command landed on the prompt" }
    timeout { puts "\nFAIL: command was not placed on the prompt"; exit 1 }
}
# Clear the line without running it.
send -- "\025"

# --- Case 2: destructive request must NOT be FILLed ---
send -- "delete all the files in my-folder"
send -- "\007"
expect {
    -re {copy or type it} {}
    timeout { puts "\nFAIL: destructive CMD line never appeared"; exit 1 }
}
# Buffer must be empty: type a sentinel and run it; if rm had been
# placed, the executed line would not be the bare sentinel.
send -- "echo SENTINEL_OK\r"
expect {
    -re {\nSENTINEL_OK} { puts "\nPASS: destructive command was withheld from the prompt" }
    timeout { puts "\nFAIL: prompt buffer was not empty"; exit 1 }
}

send -- "exit\r"
expect eof
puts "\nALL WIDGET CHECKS PASSED"
